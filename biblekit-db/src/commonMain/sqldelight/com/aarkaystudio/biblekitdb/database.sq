-- Bible.sq

CREATE TABLE IF NOT EXISTS Verse (
  id INTEGER NOT NULL PRIMARY KEY,
  number TEXT NOT NULL UNIQUE,
  text TEXT NOT NULL,
  searchText TEXT NOT NULL
);

CREATE INDEX IF NOT EXISTS Verse_on_searchText ON Verse(searchText);

CREATE VIRTUAL TABLE IF NOT EXISTS VerseFts USING FTS5(
    searchText,
    content=Verse,
    content_rowid=id,
    tokenize='porter unicode61'
);

CREATE TRIGGER IF NOT EXISTS __VerseFts_ai AFTER INSERT ON `Verse` BEGIN
    INSERT INTO `VerseFts`(`rowid`, `searchText`) VALUES (new.`id`, new.`searchText`);
END;

CREATE TRIGGER IF NOT EXISTS __VerseFts_au AFTER UPDATE ON `Verse` BEGIN
    INSERT INTO `VerseFts`(`VerseFts`, `rowid`, `searchText`) VALUES ('delete', old.`id`, old.`searchText`);
    INSERT INTO `VerseFts`(`rowid`, `searchText`) VALUES (new.`id`, new.`searchText`);
END;

CREATE TRIGGER IF NOT EXISTS __VerseFts_bd BEFORE DELETE ON `Verse` BEGIN
    INSERT INTO `VerseFts`(`VerseFts`, `rowid`, `searchText`) VALUES ('delete', old.`id`, old.`searchText`);
END;

-- BibleQueries.sq (this will be generated by SQLDelight)

insertVerse:
INSERT INTO Verse(id, number, text, searchText) VALUES (?, ?, ?, ?);

getAllVersesByIDs:
SELECT Verse.* FROM Verse WHERE Verse.id IN ? ORDER BY Verse.id LIMIT :limit OFFSET :offset;

getAllVersesByIDsAndText:
WITH
    verse_subset AS (
        SELECT Verse.* FROM Verse WHERE Verse.id IN ?
    ),
    exact_matches AS (
        SELECT rowid FROM VerseFts WHERE VerseFts MATCH '"' || :searchText || '"'
    ),
    word_matches AS (
        SELECT rowid FROM VerseFts WHERE VerseFts MATCH :searchText
    )
SELECT id, number, text, searchText FROM (
    SELECT
        v.id,
        v.number,
        v.text,
        v.searchText,
        0 AS priority
    FROM verse_subset v
    WHERE v.id IN exact_matches

    UNION

    SELECT
        v.id,
        v.number,
        v.text,
        v.searchText,
        1 AS priority
    FROM verse_subset v
    WHERE v.id IN word_matches
    AND v.id NOT IN exact_matches
)
ORDER BY priority, id
LIMIT :limit OFFSET :offset;

getAllVersesInRange:
SELECT Verse.* FROM Verse WHERE Verse.id BETWEEN ? AND ? ORDER BY Verse.id LIMIT :limit OFFSET :offset;

getAllVersesInRangeAndText:
WITH
    verse_range AS (
        SELECT Verse.* FROM Verse WHERE Verse.id BETWEEN :startId AND :endId
    ),
    exact_matches AS (
        SELECT rowid FROM VerseFts WHERE VerseFts MATCH '"' || :searchText || '"'
    ),
    word_matches AS (
        SELECT rowid FROM VerseFts WHERE VerseFts MATCH :searchText
    )
SELECT id, number, text, searchText FROM (
    SELECT
        v.id,
        v.number,
        v.text,
        v.searchText,
        0 AS priority
    FROM verse_range v
    WHERE v.id IN exact_matches

    UNION

    SELECT
        v.id,
        v.number,
        v.text,
        v.searchText,
        1 AS priority
    FROM verse_range v
    WHERE v.id IN word_matches
    AND v.id NOT IN exact_matches
)
ORDER BY priority, id
LIMIT :limit OFFSET :offset;

getAllVersesByText:
WITH
    exact_matches AS (
        SELECT rowid FROM VerseFts WHERE VerseFts MATCH '"' || :searchText || '"'
    ),
    word_matches AS (
        SELECT rowid FROM VerseFts WHERE VerseFts MATCH :searchText
    )
SELECT id, number, text, searchText FROM (
    SELECT
        v.id,
        v.number,
        v.text,
        v.searchText,
        0 AS priority
    FROM Verse v
    WHERE v.id IN exact_matches

    UNION

    SELECT
        v.id,
        v.number,
        v.text,
        v.searchText,
        1 AS priority
    FROM Verse v
    WHERE v.id IN word_matches
    AND v.id NOT IN exact_matches
)
ORDER BY priority, id
LIMIT :limit OFFSET :offset;
